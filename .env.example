# JWT署名用秘密鍵 (必須・本番環境では必ずランダムな値を設定すること)
# 生成例: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="your-secret-key-here"

# データベース接続設定 (DB_URL か DB_USER/DB_PASS のどちらかを設定する)
DB_USER="root"
DB_PASS=""
DB_HOST="localhost"
# DB_PORT="3306"
DB_NAME="icha"

# または完全なDB URLで指定
# DB_URL="mysql+asyncmy://user:password@localhost/icha"

# CORS許可オリジン (カンマ区切り)
CORS_LIST="http://localhost:3000,http://127.0.0.1:3000"

# フロントエンド設定
NEXT_PUBLIC_BASE_URL="http://localhost:8000"
NEXT_PUBLIC_DEBUG=false
